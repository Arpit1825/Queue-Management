<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <title>Analytics | SmartQueue</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sqbg: "#070d18",
                        sqsidebar: "#0a1220",
                        sqpanel: "#0d1726",
                        sqpanel2: "#101c2d",
                        sqborder: "#1c293c",
                        sqblue: "#3b82f6"
                    }
                }
            }
        };
    </script>
</head>

<body class="min-h-screen bg-sqbg text-slate-100">

    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside
        class="fixed left-0 top-0 bottom-0 z-50 hidden w-[250px] border-r border-[#1c293c] bg-[#0a1220] px-[18px] py-[25px] lg:block"
    >

        <!-- BRAND -->
        <a
            href="/dashboard"
            class="mb-[45px] flex items-center gap-[10px] px-[10px] no-underline"
        >
            <svg
                viewBox="0 0 24 24"
                class="h-[34px] w-[34px] text-[#3b82f6]"
                fill="currentColor"
            >
                <path
                    d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,6V12.4L15.5,15.1L16.25,13.8L12.5,11.6V6H11Z"
                />
            </svg>
            <div class="text-[21px] font-extrabold text-white">
                Smart<span class="text-[#3b82f6]">Queue</span>
            </div>
        </a>

        <!-- NAV TITLE -->
        <div
            class="mb-3 px-3 text-[11px] uppercase tracking-[1px] text-slate-500"
        >
            Main Menu
        </div>

        <!-- NAVIGATION -->
        <nav class="flex flex-col gap-[7px]">

            <!-- DASHBOARD -->
            <a
                href="/dashboard"
                class="group flex items-center gap-[13px] rounded-[10px] border-l-[3px] border-transparent px-[14px] py-[13px] text-[14px] text-slate-400 no-underline transition hover:bg-blue-500/10 hover:text-white"
            >
                <i class="fa-solid fa-house w-5 text-center"></i>
                <span>Dashboard</span>
            </a>

            <!-- QUEUE -->
            <a
                href="/queue-management"
                class="group flex items-center gap-[13px] rounded-[10px] border-l-[3px] border-transparent px-[14px] py-[13px] text-[14px] text-slate-400 no-underline transition hover:bg-blue-500/10 hover:text-white"
            >
                <i class="fa-solid fa-layer-group w-5 text-center"></i>
                <span>Queue</span>
            </a>

            <!-- ANALYTICS ACTIVE -->
            <a
                href="/analytics"
                class="group flex items-center gap-[13px] rounded-[10px] border-l-[3px] border-[#3b82f6] bg-gradient-to-r from-blue-500/25 to-blue-500/5 px-[14px] py-[13px] text-[14px] text-white no-underline transition"
            >
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span>Analytics</span>
            </a>

            <!-- PROFILE -->
            <a
                href="/profile"
                class="group flex items-center gap-[13px] rounded-[10px] border-l-[3px] border-transparent px-[14px] py-[13px] text-[14px] text-slate-400 no-underline transition hover:bg-blue-500/10 hover:text-white"
            >
                <i class="fa-solid fa-user w-5 text-center"></i>
                <span>Profile</span>
            </a>
        </nav>

        <!-- SIDEBAR BOTTOM -->
        <div class="absolute bottom-[25px] left-[18px] right-[18px]">

            <!-- SUPPORT -->
            <div
                class="mb-[15px] rounded-[14px] border border-[#24334a] bg-[#101b2c] p-[18px]"
            >
                <h4 class="mb-[5px] text-[13px] font-semibold text-white">
                    <i class="fa-solid fa-headset mr-1"></i>
                    Need Help?
                </h4>
                <p class="m-0 text-[11px] text-[#71829d]">
                    Contact SmartQueue support
                </p>
            </div>

            <!-- LOGOUT -->
            <a
                href="/logout"
                class="flex items-center gap-[10px] px-3 py-3 text-[14px] text-slate-400 no-underline transition hover:text-white"
            >
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>


    <!-- =========================================================
         MAIN
    ========================================================== -->

    <main class="ml-[250px] min-h-screen">


        <!-- =====================================================
             TOPBAR
        ====================================================== -->

        <header
            class="sticky top-0 z-40 flex h-[75px] items-center justify-between border-b border-sqborder bg-sqsidebar px-8"
        >

            <!-- LEFT -->

            <div>

                <div class="text-xs text-slate-500">
                    SmartQueue
                </div>

                <div class="mt-0.5 text-sm font-semibold text-slate-200">
                    Analytics Overview
                </div>

            </div>

        </header>


        <!-- =====================================================
             PAGE CONTENT
        ====================================================== -->

        <section class="mx-auto max-w-[1500px] p-[35px]">


            <!-- PAGE HEADER -->

            <div class="mb-8">

                <div
                    class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-blue-400"
                >

                    <i class="fa-solid fa-chart-line"></i>

                    Analytics

                </div>


                <h1
                    class="mt-4 text-3xl font-bold tracking-tight text-white md:text-4xl"
                >
                    Queue Analytics
                </h1>


                <p class="mt-2 text-sm text-slate-500">
                    Monitor queue performance and service metrics.
                </p>

            </div>


            <!-- =================================================
                 KPI CARDS
            ================================================== -->

            <div
                class="mb-7 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4"
            >


                <!-- COMPLETED -->

                <div
                    class="rounded-2xl border border-sqborder bg-sqpanel p-5 transition-all duration-200 hover:border-blue-500/30"
                >

                    <div class="flex items-start justify-between">

                        <div>

                            <p class="text-sm text-slate-500">
                                Completed
                            </p>

                            <h2
                                id="completedCount"
                                class="mt-3 text-3xl font-bold text-white"
                            >
                                0
                            </h2>

                            <p class="mt-2 text-xs text-emerald-400">
                                Successfully served
                            </p>

                        </div>


                        <div
                            class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-500/10"
                        >

                            <i
                                class="fa-solid fa-circle-check text-emerald-400"
                            ></i>

                        </div>

                    </div>

                </div>


                <!-- WAITING -->

                <div
                    class="rounded-2xl border border-sqborder bg-sqpanel p-5 transition-all duration-200 hover:border-blue-500/30"
                >

                    <div class="flex items-start justify-between">

                        <div>

                            <p class="text-sm text-slate-500">
                                Waiting
                            </p>

                            <h2
                                id="waitingCount"
                                class="mt-3 text-3xl font-bold text-white"
                            >
                                0
                            </h2>

                            <p class="mt-2 text-xs text-amber-400">
                                Customers in queue
                            </p>

                        </div>


                        <div
                            class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-500/10"
                        >

                            <i
                                class="fa-solid fa-users text-amber-400"
                            ></i>

                        </div>

                    </div>

                </div>


                <!-- SERVING -->

                <div
                    class="rounded-2xl border border-sqborder bg-sqpanel p-5 transition-all duration-200 hover:border-blue-500/30"
                >

                    <div class="flex items-start justify-between">

                        <div>

                            <p class="text-sm text-slate-500">
                                Serving
                            </p>

                            <h2
                                id="servingCount"
                                class="mt-3 text-3xl font-bold text-white"
                            >
                                0
                            </h2>

                            <p class="mt-2 text-xs text-blue-400">
                                Currently being served
                            </p>

                        </div>


                        <div
                            class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-500/10"
                        >

                            <i
                                class="fa-solid fa-user-clock text-blue-400"
                            ></i>

                        </div>

                    </div>

                </div>


                <!-- TOTAL -->

                <div
                    class="rounded-2xl border border-sqborder bg-sqpanel p-5 transition-all duration-200 hover:border-blue-500/30"
                >

                    <div class="flex items-start justify-between">

                        <div>

                            <p class="text-sm text-slate-500">
                                Total Tokens
                            </p>

                            <h2
                                id="totalCount"
                                class="mt-3 text-3xl font-bold text-white"
                            >
                                0
                            </h2>

                            <p class="mt-2 text-xs text-purple-400">
                                Overall activity
                            </p>

                        </div>


                        <div
                            class="flex h-11 w-11 items-center justify-center rounded-xl bg-purple-500/10"
                        >

                            <i
                                class="fa-solid fa-ticket text-purple-400"
                            ></i>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 MAIN ANALYTICS GRID
            ================================================== -->

            <div
                class="mb-6 grid grid-cols-1 gap-6 xl:grid-cols-[1.7fr_1fr]"
            >


                <!-- RECENT COMPLETED -->

                <div
                    class="rounded-2xl border border-sqborder bg-sqpanel p-6"
                >

                    <div
                        class="mb-4 flex items-center justify-between border-b border-sqborder pb-4"
                    >

                        <div>

                            <h3 class="text-sm font-semibold text-white">
                                Recent Completed Tokens
                            </h3>

                            <p class="mt-1 text-xs text-slate-500">
                                Latest successfully completed services
                            </p>

                        </div>


                        <div
                            class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-500/10"
                        >

                            <i
                                class="fa-solid fa-clock-rotate-left text-sm text-blue-400"
                            ></i>

                        </div>

                    </div>


                    <div
                        id="recentCompleted"
                        class="flex flex-col gap-2"
                    >
                        <!-- Injected dynamically -->
                    </div>

                </div>


                <!-- SERVICE DISTRIBUTION -->

                <div
                    class="rounded-2xl border border-sqborder bg-sqpanel p-6"
                >

                    <div
                        class="mb-4 flex items-center justify-between border-b border-sqborder pb-4"
                    >

                        <div>

                            <h3 class="text-sm font-semibold text-white">
                                Service Distribution
                            </h3>

                            <p class="mt-1 text-xs text-slate-500">
                                Category breakdown
                            </p>

                        </div>


                        <div
                            class="flex h-9 w-9 items-center justify-center rounded-lg bg-purple-500/10"
                        >

                            <i
                                class="fa-solid fa-chart-pie text-sm text-purple-400"
                            ></i>

                        </div>

                    </div>


                    <div
                        id="serviceStats"
                        class="flex flex-col gap-2"
                    >
                        <!-- Injected dynamically -->
                    </div>

                </div>

            </div>


            <!-- =================================================
                 AVERAGE SERVICE TIME
            ================================================== -->

            <div
                class="rounded-2xl border border-sqborder bg-sqpanel p-6"
            >

                <div class="flex items-center justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Average Service Time
                        </p>

                        <h2
                            id="avgServiceTime"
                            class="mt-2 text-3xl font-bold text-white"
                        >
                            0m
                        </h2>

                        <p class="mt-2 text-xs text-slate-500">
                            Average time required to complete a service
                        </p>

                    </div>


                    <div
                        class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-500/10"
                    >

                        <i
                            class="fa-solid fa-stopwatch text-blue-400"
                        ></i>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- =========================================================
         ANALYTICS LOGIC
         ORIGINAL LOGIC — DO NOT CHANGE
    ========================================================== -->

    <script>

        async function loadAnalytics(){

            const res = await fetch("/queue/analytics");

            const data = await res.json();


            /* KPI */

            document.getElementById("completedCount").textContent =
                data.totalCompleted;

            document.getElementById("waitingCount").textContent =
                data.totalWaiting;

            document.getElementById("servingCount").textContent =
                data.totalServing;

            document.getElementById("totalCount").textContent =
                data.totalCompleted +
                data.totalWaiting +
                data.totalServing;


            /* SERVICE DISTRIBUTION */

            document.getElementById("serviceStats").innerHTML =
                data.serviceStats.map(service => {

                    return `

                        <div
                            class="flex items-center justify-between rounded-xl border border-sqborder bg-sqpanel2 px-4 py-3 transition-all duration-200 hover:border-blue-500/20"
                        >

                            <div class="flex items-center gap-3">

                                <div
                                    class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-500/10"
                                >

                                    <i
                                        class="fa-solid fa-layer-group text-xs text-blue-400"
                                    ></i>

                                </div>

                                <span class="text-sm text-slate-300">
                                    ${service._id}
                                </span>

                            </div>


                            <span
                                class="text-sm font-semibold text-white"
                            >
                                ${service.count}
                            </span>

                        </div>

                    `;

                }).join("");


            /* AVG SERVICE TIME */

            document.getElementById("avgServiceTime").textContent =
                `${data.avgServiceTime}m`;


            /* RECENT COMPLETED */

            document.getElementById("recentCompleted").innerHTML =
                data.recentCompleted.map(token => {

                    return `

                        <div
                            class="flex items-center justify-between rounded-xl border border-sqborder bg-sqpanel2 px-4 py-3 transition-all duration-200 hover:border-blue-500/20"
                        >

                            <div class="flex items-center gap-3">

                                <div
                                    class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500/10"
                                >

                                    <i
                                        class="fa-solid fa-check text-xs text-emerald-400"
                                    ></i>

                                </div>


                                <div>

                                    <div
                                        class="text-sm font-semibold text-slate-200"
                                    >
                                        Token ${token.tokenNumber}
                                    </div>

                                    <div
                                        class="mt-0.5 text-xs text-slate-500"
                                    >
                                        Service completed
                                    </div>

                                </div>

                            </div>


                            <div
                                class="rounded-lg bg-blue-500/10 px-3 py-1.5 text-xs text-blue-400"
                            >
                                Counter ${token.counterId}
                            </div>

                        </div>

                    `;

                }).join("");

        }


        /* Initial Load */

        loadAnalytics();

    </script>


    <!-- SOCKET.IO -->

    <script src="/socket.io/socket.io.js"></script>

    <script>

        const socket = io();

        socket.on("queueUpdated", () => {

            loadAnalytics();

        });

    </script>


    <!-- Existing common JS -->

    <script src="/js/index.js"></script>

</body>

</html>